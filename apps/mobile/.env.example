# Host name the phone uses to reach Metro (`just mobile`), for example the dev machine's Tailscale name.
ORBIT_MOBILE_HOST=devserver.tail661ee3.ts.net

# Prefilled server on the sign-in screen (Orbit Cloud, https://app.orbit.so, when unset). The phone must reach it (Tailscale, LAN IP, or a public URL).
EXPO_PUBLIC_ORBIT_SERVER=https://devserver.tail661ee3.ts.net:18888

# iOS Expo Go only opens a project when Expo CLI and Expo Go use the same account.
# On a remote server, use a personal access token (expo.dev → Account settings → Access tokens).
# A robot token does not work: robots cannot sign in to Expo Go.
# EXPO_TOKEN=
