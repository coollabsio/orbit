{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ORBIT_SERVER": "https://app.orbit.so" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ORBIT_SERVER": "https://app.orbit.so" }
    }
  },
  "submit": {
    "production": {}
  }
}
