ORBIT_DOMAIN=orbit.example.com
# Required. Create it with `openssl rand -base64 32` and keep a copy outside this server:
# without it, Orbit cannot read the secrets it saved (SMTP password, S3 secret, GitHub App keys, 2FA).
ORBIT_APP_KEY=
# To deploy a published release, set this and use `up -d --no-build`:
# ORBIT_IMAGE=ghcr.io/OWNER/REPOSITORY:v0.1.0
